(module
  (memory (export "memory") 2)
  (data (i32.const 16) "{\"api\":1,\"author\":\"EffectCraft legacy corpus\",\"category\":\"Corpus Plug-ins\",\"description\":\"Writes the frame times, flags and neighbour pixels into the pixels.\",\"id\":\"org.example.corpus.neighbour-probe\",\"name\":\"Corpus Neighbour Probe\",\"params\":[],\"version\":\"1.0.0\"}")
